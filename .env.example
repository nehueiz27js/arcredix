# Copiar a .env.local y completar localmente.
# DATABASE_URL debe ser la conexión pooled de Neon (host con -pooler).
# DATABASE_URL_UNPOOLED es la conexión directa (sin -pooler), solo para npm run migrate.
# No subir .env.local a Git ni compartir sus valores.

DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Usar la URL Neon Auth de la MISMA rama que DATABASE_URL.
# No copiar la URL de producción si estás probando contra una rama Neon separada.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Lista privada de emails Neon Auth habilitados como superadministradores.
# Separar múltiples direcciones con coma. No usar un email que no controles.
ARCREDIX_SUPERADMIN_EMAILS=

# Provider webhook runtime (separate restricted database role)
ARCREDIX_WEBHOOK_DATABASE_URL=
ARCREDIX_CRON_SECRET=

# Google OAuth / Gmail push notifications
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/merchant/connections/gmail/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION=

# Mercado Pago OAuth / webhook signature
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/api/merchant/connections/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_SECRET=
